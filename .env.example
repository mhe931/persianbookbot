# Telegram bot token from @BotFather. Leave empty to run the API/Mini App only (no bot polling).
BOT_TOKEN=

# Host/port for the local FastAPI Mini App backend.
API_HOST=0.0.0.0
API_PORT=8000

# OCR engine backend: "dummy" (deterministic offline fallback, default),
# "tesseract", "paddle", or "vision_llm".
OCR_ENGINE=dummy

# PaddleOCR backend options (only used when OCR_ENGINE=paddle). Requires the
# optional 'paddle' extra (pip install .[paddle]) - not installed by default.
PADDLE_USE_GPU=False
PADDLE_LANG=fa

# Vision-LLM backend options (only used when OCR_ENGINE=vision_llm). Requires
# the optional 'vision-llm' extra (pip install .[vision-llm]) - not installed
# by default. Provider is "gemini" or "claude"; leave the API key empty
# unless you are actually using this backend, and never commit a real key.
VISION_LLM_PROVIDER=gemini
VISION_LLM_API_KEY=
VISION_LLM_MODEL=gemini-1.5-flash

# Directories for uploaded PDFs and generated output artifacts.
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/output

# Maximum accepted upload size in megabytes.
MAX_FILE_SIZE_MB=20

# Telegram/OCR rate-limit retry policy.
RATE_LIMIT_MAX_RETRIES=3
RATE_LIMIT_BACKOFF_SECONDS=2.0

# Optional webhook URL if running the bot in webhook mode instead of polling.
WEBHOOK_URL=

# Optional Persian font family name used by DOCX/EPUB converters.
PERSIAN_FONT_NAME=

# Structured logging: "console" (human-readable, default) or "json"
# (one JSON object per line, for log aggregation). LOG_LEVEL is a standard
# Python logging level name (DEBUG/INFO/WARNING/ERROR).
LOG_FORMAT=console
LOG_LEVEL=INFO

# How long (seconds) a finished job (done/failed/rate_limited) and its
# upload/output files are kept before JobManager.cleanup_stale_jobs() prunes
# them. Default: 24 hours.
JOB_RETENTION_SECONDS=86400

# How often (seconds) bot.main's periodic cleanup worker calls
# default_job_manager.cleanup_stale_jobs() while the process is running.
# Default: 1 hour (3600). Set to 0 or a negative value to disable the
# periodic worker (cleanup remains callable on demand).
CLEANUP_INTERVAL_SECONDS=3600

