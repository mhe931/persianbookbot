# Nginx reverse-proxy template for persianbookbot. Rendered into
# /etc/nginx/conf.d/default.conf by the official nginx:1.27-alpine image's
# docker-entrypoint envsubst-on-templates behavior (any *.template file
# under /etc/nginx/templates/ is processed on container start) - see
# ../docker-compose.prod.yml. Only ${DOMAIN} is substituted; every other
# `$variable` below is a native nginx variable, left untouched because it
# is not present in the container environment.
#
# "bot.example.com" is a documentation-only placeholder - replace it via
# the DOMAIN environment variable at deploy time (see
# ../../docs/DEPLOYMENT_GUIDE.md). Never hardcode a real domain here.

# Plain-HTTP server: serves the ACME HTTP-01 challenge (required for
# Certbot to issue/renew certificates) and redirects everything else to
# HTTPS. This must keep working even before a certificate exists yet.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge webroot, shared with the certbot
    # container via the ./certbot/www volume. Must be reachable over
    # plain HTTP for issuance/renewal to succeed.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Self-contained liveness endpoint for the Docker/orchestrator
    # HEALTHCHECK (see ../docker-compose.prod.yml). Deliberately does not
    # depend on a TLS certificate existing yet, so it stays healthy during
    # the first-issuance bootstrap window described in
    # ../../docs/DEPLOYMENT_GUIDE.md.
    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }

    # Everything else: redirect to HTTPS on the same host/path.
    location / {
        return 301 https://$host$request_uri;
    }
}

# TLS server: terminates HTTPS and reverse-proxies to the bot container.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Issued into ./certbot/conf by the certbot service (see
    # docs/DEPLOYMENT_GUIDE.md for the first-issuance command). Paths
    # follow Certbot's standard `/etc/letsencrypt/live/<domain>/` layout.
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Also serve the ACME challenge over HTTPS so renewal keeps working
    # even if a client only ever reaches the TLS vhost.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Telegram Mini App static frontend, proxied to the bot container's
    # FastAPI StaticFiles mount (src/bot/api.py mounts "/" last, after all
    # /api/* routes).
    location / {
        proxy_pass http://bot:8000;
        proxy_http_version 1.1;

        # Standard forwarded headers so the bot sees the real client
        # address/scheme/host instead of nginx's.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }

    # FastAPI Mini App/API surface, including POST /api/telegram/webhook.
    # Kept as an explicit location (rather than falling through `/`) so
    # webhook/API traffic is unambiguously routed and documented.
    location /api/ {
        proxy_pass http://bot:8000/api/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Telegram's webhook secret-token header (validated by
        # src/bot/api.py before the request body is ever parsed) must
        # pass through untouched - nginx forwards all headers by default,
        # but this is called out explicitly since it is security-critical
        # and easy to accidentally strip with an over-eager
        # proxy_hide_header/proxy_pass_request_headers off elsewhere.
        proxy_pass_request_headers on;
        proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;

        # Uploads can be sizeable scanned PDFs (see MAX_FILE_SIZE_MB in
        # .env.example); raise nginx's default 1m client body limit well
        # above the bot's own enforced ceiling so nginx never rejects a
        # request the bot would otherwise accept.
        client_max_body_size 32m;
    }
}
